#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SESSION="${AIB_TMUX_SESSION:-aib}"
COMPOSE_FILE="${REPO_ROOT}/docker-compose.yml"
MAILPIT_URL="http://localhost:8027"

if ! command -v tmux >/dev/null 2>&1; then
  echo "tmux not found. Install with: brew install tmux" >&2
  exit 1
fi

# Free ports even if servers were started outside tmux
"${REPO_ROOT}/scripts/free-port" 5080 3000

# Local SMTP catcher (Mailpit) via docker compose
if [[ -f "${COMPOSE_FILE}" ]] && command -v docker >/dev/null 2>&1; then
  if docker compose -f "${COMPOSE_FILE}" up -d mailpit; then
    echo "Mailpit → ${MAILPIT_URL} (SMTP :1025)"
    if command -v open >/dev/null 2>&1; then
      open "${MAILPIT_URL}"
    elif command -v xdg-open >/dev/null 2>&1; then
      xdg-open "${MAILPIT_URL}" >/dev/null 2>&1 || true
    fi
  else
    echo "Warning: could not start Mailpit (docker compose). Emails may fail." >&2
  fi
else
  echo "Warning: Docker or docker-compose.yml missing — Mailpit not started." >&2
fi

if tmux has-session -t "${SESSION}" 2>/dev/null; then
  echo "Stopping existing tmux session '${SESSION}'…"
  tmux kill-session -t "${SESSION}"
fi

# One window, two rows: top = API, bottom = UI
tmux new-session -d -s "${SESSION}" -c "${REPO_ROOT}" -n aib \
  "${REPO_ROOT}/scripts/run-api"

tmux split-window -v -t "${SESSION}:aib" -c "${REPO_ROOT}" \
  "${REPO_ROOT}/scripts/run-ui"

tmux select-pane -t "${SESSION}:aib.0"
tmux select-layout -t "${SESSION}:aib" even-vertical

echo "Started tmux session '${SESSION}' (top: api, bottom: ui)."
echo "  attach:  tmux attach -t ${SESSION}"
echo "  UI:      https://localhost:3000"
echo "  API:     http://localhost:5080/health"
echo "  Mailpit: ${MAILPIT_URL}"

exec tmux attach -t "${SESSION}"
