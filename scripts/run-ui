#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UI_DIR="${REPO_ROOT}/frontend"
CERT_FILE="${REPO_ROOT}/certs/localhost.pem"
KEY_FILE="${REPO_ROOT}/certs/localhost-key.pem"
UI_PORT="${UI_PORT:-3000}"

if [[ ! -f "${CERT_FILE}" || ! -f "${KEY_FILE}" ]]; then
  echo "Trusted localhost certs missing — running ./scripts/dev-bootstrap.sh…"
  "${REPO_ROOT}/scripts/dev-bootstrap.sh"
fi

cd "${UI_DIR}"

if [[ ! -d node_modules ]]; then
  echo "node_modules missing — running npm install…"
  npm install
fi

"${REPO_ROOT}/scripts/free-port" "${UI_PORT}"

API_URL="${API_URL:-http://127.0.0.1:5080}"
API_HEALTH="${API_URL}/health"
echo "Waiting for API at ${API_HEALTH}…"
until curl -sf --connect-timeout 1 "${API_HEALTH}" >/dev/null 2>&1; do
  sleep 0.5
done
echo "API ready."

echo "UI → https://localhost:${UI_PORT} (proxies /api → ${API_URL})"
exec npm run dev -- --port "${UI_PORT}" "$@"
